#: tracker/web/templates/_page_id_help.html:3
msgid "How do I find a page ID?"
msgstr "¿Cómo encuentro el ID de una página?"

#: tracker/web/templates/_page_id_help.html:5
msgid "Open the <a href=\"https://www.facebook.com/ads/library/\" target=\"_blank\" rel=\"noopener noreferrer\">Meta Ad Library</a> and search for the advertiser."
msgstr "Abre la <a href=\"https://www.facebook.com/ads/library/\" target=\"_blank\" rel=\"noopener noreferrer\">Biblioteca de anuncios de Meta</a> y busca al anunciante."

#: tracker/web/templates/_page_id_help.html:6
msgid "Click the advertiser's name. The address now contains <code>view_all_page_id=</code> followed by digits: that's the page ID."
msgstr "Haz clic en el nombre del anunciante. La dirección ahora contiene <code>view_all_page_id=</code> seguido de dígitos: ese es el ID de la página."

#: tracker/web/templates/_page_id_help.html:7
msgid "Don't use the Library ID shown on an ad: that identifies one ad, not the page."
msgstr "No uses el identificador de la biblioteca que aparece en un anuncio: identifica un anuncio, no la página."

