msgid "How much it costs"
msgstr "Cuánto cuesta"

#: tracker/web/templates/help_apify.html:43
msgid "per 1,000 ads collected"
msgstr "por cada 1.000 anuncios recopilados"

#: tracker/web/templates/help_apify.html:44
msgid "per Actor run (each reads up to 5 pages)"
msgstr "por ejecución del Actor (cada una lee hasta 5 páginas)"

#: tracker/web/templates/help_apify.html:45
msgid "free every month on Apify's free plan"
msgstr "gratis cada mes en el plan gratuito de Apify"

#: tracker/web/templates/help_apify.html:47
#, python-format
msgid "Apify's free plan gives US$ %(credit)s of usage every month, with no credit card. That's about %(ads)s ads a month at no cost. Unused credit doesn't carry over to the next month."
msgstr "El plan gratuito de Apify da US$ %(credit)s de uso cada mes, sin tarjeta de crédito. Eso son unos %(ads)s anuncios al mes sin coste. El crédito no usado no pasa al mes siguiente."

#: tracker/web/templates/help_apify.html:49
msgid "An example"
msgstr "Un ejemplo"

#: tracker/web/templates/help_apify.html:50
#, python-format
msgid "%(pages)s competitors with about %(per_page)s active ads each: one collection reads about %(ads)s ads and costs about US$ %(cost)s."
msgstr "%(pages)s competidores con unos %(per_page)s anuncios activos cada uno: una recopilación lee unos %(ads)s anuncios y cuesta unos US$ %(cost)s."

#: tracker/web/templates/help_apify.html:52
msgid "About per month"
msgstr "Aprox. al mes"

#: tracker/web/templates/help_apify.html:54
msgid "Once a day"
msgstr "Una vez al día"

#: tracker/web/templates/help_apify.html:54
msgid "within the free credit"
msgstr "dentro del crédito gratuito"

#: tracker/web/templates/help_apify.html:55
#: tracker/web/templates/setup_collection.html:21
