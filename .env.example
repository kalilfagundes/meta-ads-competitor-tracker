# ═══════════════════════════════════════════════════════════════════════
#  meta-ads-competitor-tracker — configuration for docker compose
#
#  Easiest: run ./setup.sh (Linux/macOS) or .\setup.ps1 (Windows), which asks a
#  few questions and writes .env for you. Or copy this file to .env and fill it in.
#
#  Only infrastructure lives here. The admin account, competitors, country and
#  collection schedule are set in the browser, in the first-run wizard.
#  Keep .env private: it holds passwords.
# ═══════════════════════════════════════════════════════════════════════

# Bundled services to run, comma-separated:
#   postgres  the built-in database (leave it out to use your own, below)
#   garage    the built-in media storage (leave it out to use an external S3)
COMPOSE_PROFILES=postgres,garage

# Port of the web app on this machine.
WEB_PORT=8765

# Optional. Reverse proxies whose X-Forwarded-For/-Proto headers the app believes, to see
# the visitor's real IP (login limit) and HTTPS (secure cookie). The default trusts
# private networks, which covers a proxy on this machine or in Docker (Caddy, nginx,
# Traefik, Coolify). Only a proxy at a public IP needs it, e.g.:
#   FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,203.0.113.10
# Don't use *: anyone could then fake their IP and dodge the login limit.

# ── Database ────────────────────────────────────────────────────────────
# Built-in Postgres: keep POSTGRES_HOST=postgres and set a long random password
# (letters and digits), e.g. the output of: openssl rand -hex 24
# Your own Postgres: its host, port, database, user and password, and usually
# POSTGRES_SSLMODE=require.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=

# ── Media storage (S3-compatible) ───────────────────────────────────────
# Built-in Garage: keep the endpoint, region and path style. The access key (8+
# characters) and secret key (16+ characters, no spaces or quotes) are yours to
# pick; Garage is set up with them on first start.
S3_ENDPOINT=http://garage:3900
S3_BUCKET=ads-media
S3_REGION=garage
S3_ACCESS_KEY_ID=tracker_media
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Garage's own secrets (built-in Garage only):
#   GARAGE_RPC_SECRET   exactly 64 hex characters: openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN  a long random value: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# External bucket instead (remove "garage" from COMPOSE_PROFILES and the GARAGE_*
# lines), for example:
#   Cloudflare R2:  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   AWS S3:         S3_ENDPOINT=  (empty)  S3_REGION=us-east-1  S3_FORCE_PATH_STYLE=false
# The bucket is created on start if it doesn't exist. It doesn't need to be public.

# ── Session ─────────────────────────────────────────────────────────────
# Signs the login cookie. Required, at least 32 characters, e.g.: openssl rand -hex 32
# (the web app refuses to start without it).
SESSION_SECRET=

# ── First-run setup ─────────────────────────────────────────────────────
# Asked by the setup wizard when creating the administrator, so nobody else who
# reaches a fresh instance can claim it. Any random value, e.g.: openssl rand -hex 12
# Left empty, the web app generates one and prints it in: docker compose logs web
SETUP_TOKEN=
